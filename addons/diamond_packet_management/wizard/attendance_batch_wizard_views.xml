<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_diamond_attendance_batch_wizard_form" model="ir.ui.view">
            <field name="name">diamond.attendance.batch.wizard.form</field>
            <field name="model">diamond.attendance.batch.wizard</field>
            <field name="arch" type="xml">
                <form string="Mark Daily Attendance">
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="default_status"/>
                            <field name="only_fixed_salary"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Change Default Status or Fixed-Salary filter to reload the employee list,
                        then adjust rows and confirm.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="true">
                            <field name="employee_id" readonly="1" force_save="1"/>
                            <field name="status"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_confirm" string="Save Attendance"
                                type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_diamond_attendance_batch_wizard" model="ir.actions.act_window">
            <field name="name">Mark Daily Attendance</field>
            <field name="res_model">diamond.attendance.batch.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_diamond_attendance_batch"
                  name="Mark Daily Attendance"
                  parent="menu_diamond_labour_root"
                  action="action_diamond_attendance_batch_wizard"
                  sequence="6"/>

    </data>
</odoo>
