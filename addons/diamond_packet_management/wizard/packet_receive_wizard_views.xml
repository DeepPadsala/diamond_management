<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_diamond_packet_receive_wizard_form" model="ir.ui.view">
            <field name="name">diamond.packet.receive.wizard.form</field>
            <field name="model">diamond.packet.receive.wizard</field>
            <field name="arch" type="xml">
                <form string="Receive Packet(s)">
                    <sheet>
                        <h1 class="text-center">
                            <i class="fa fa-sign-in me-2"/>
                            Receive Packet(s)
                        </h1>

                        <group>
                            <group>
                                <field name="mode" widget="radio"/>
                                <field name="date"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Source">
                                <field name="process_id" options="{'no_create_edit': True}"/>
                                <field name="ledger_id" options="{'no_create_edit': True}"/>
                                <field name="employee_id" options="{'no_create_edit': True}"/>
                            </group>
                        </group>

                        <field name="show_labour" invisible="1"/>
                        <field name="show_party_labour" invisible="1"/>
                        <field name="show_worker_labour" invisible="1"/>
                        <field name="show_unprocessed" invisible="1"/>
                        <field name="show_new_color" invisible="1"/>

                        <separator string="Received Weights"/>
                        <p class="text-muted">
                            Enter the actual <b>Received Cts</b> for each packet;
                            loss is calculated automatically.
                        </p>
                        <field name="line_ids">
                            <list editable="bottom" create="false">
                                <field name="packet_id" readonly="1" force_save="1"/>
                                <field name="barcode" readonly="1"/>
                                <field name="shape" readonly="1"/>
                                <field name="color" readonly="1"/>
                                <field name="clarity" readonly="1"/>
                                <field name="old_pcs" string="Issued Pcs"/>
                                <field name="old_cts" string="Issued Cts"/>
                                <field name="labour_weight_cts" string="Labour Wt"
                                       readonly="1"
                                       column_invisible="parent.mode != 'factory'"/>
                                <field name="new_cts" string="Recv Cts"/>
                                <field name="new_pcs" string="Recv Pcs"/><field name="unprocessed"
                                       column_invisible="not parent.show_unprocessed"/>
                                <field name="loss_cts"
                                       decoration-danger="loss_cts &gt; 0"
                                       decoration-success="loss_cts &lt; 0"/>
                                <field name="loss_pct" optional="show"/>
                                <field name="new_color_id"
                                       column_invisible="not parent.show_new_color"/>
                                <field name="party_labour_amount" readonly="1"
                                       column_invisible="not parent.show_party_labour"/>
                                <field name="worker_labour_amount" readonly="1"
                                       column_invisible="not parent.show_worker_labour"/>
                                <field name="labour_amount"
                                       column_invisible="parent.mode != 'jobwork'"/>
                                <field name="allow_weight_gain" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                        </field>

                        <group class="oe_subtotal_footer oe_right">
                            <field name="total_old_cts" readonly="1"/>
                            <field name="total_new_cts" readonly="1"/>
                            <field name="total_loss_cts" readonly="1"/>
                            <field name="total_loss_pct" readonly="1"/>
                        </group>

                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_receive"
                                string="Receive &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_diamond_packet_receive_wizard" model="ir.actions.act_window">
            <field name="name">Receive Packet(s)</field>
            <field name="res_model">diamond.packet.receive.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list,form</field>
        </record>

        <record id="action_packet_receive_process_server" model="ir.actions.server">
            <field name="name">Process Receive (Selected)</field>
            <field name="model_id" ref="model_diamond_packet"/>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    "type": "ir.actions.act_window",
    "name": "Receive Packet(s)",
    "res_model": "diamond.packet.receive.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_ids": records.ids,
        "active_model": "diamond.packet",
        "default_receive_mode": "process",
    },
}</field>
        </record>

        <record id="action_packet_receive_factory_server" model="ir.actions.server">
            <field name="name">Factory Receive (Selected)</field>
            <field name="model_id" ref="model_diamond_packet"/>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    "type": "ir.actions.act_window",
    "name": "Receive Packet(s)",
    "res_model": "diamond.packet.receive.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_ids": records.ids,
        "active_model": "diamond.packet",
        "default_receive_mode": "factory",
    },
}</field>
        </record>

        <record id="action_packet_receive_jobwork_server" model="ir.actions.server">
            <field name="name">Jobwork Receive (Selected)</field>
            <field name="model_id" ref="model_diamond_packet"/>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    "type": "ir.actions.act_window",
    "name": "Receive Packet(s)",
    "res_model": "diamond.packet.receive.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_ids": records.ids,
        "active_model": "diamond.packet",
        "default_receive_mode": "jobwork",
    },
}</field>
        </record>

        <record id="action_packet_receive_hpht_server" model="ir.actions.server">
            <field name="name">HPHT Receive (Selected)</field>
            <field name="model_id" ref="model_diamond_packet"/>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    "type": "ir.actions.act_window",
    "name": "Receive Packet(s)",
    "res_model": "diamond.packet.receive.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_ids": records.ids,
        "active_model": "diamond.packet",
        "default_receive_mode": "hpht",
    },
}</field>
        </record>

    </data>
</odoo>
