<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_diamond_packet_correction_packet_list" model="ir.ui.view">
            <field name="name">diamond.packet.correction.packet.list</field>
            <field name="model">diamond.packet</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" edit="false">
                    <field name="packet_no" string="Sequence"/>
                    <field name="barcode"/>
                    <field name="state" string="Status"/>
                    <field name="current_process_id" string="Current Process"/>
                    <field name="pending_factory_process_id" string="Pending Process" optional="show"/>
                    <field name="pending_factory_labour_weight_cts" string="Pending Labour Wt" optional="show"/>
                    <field name="current_employee_id" string="Current Employee"/>
                    <field name="pending_factory_employee_id" string="Pending Employee" optional="show"/>
                    <field name="current_holder_id" string="Current Party"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_packet_issue_correction_wizard_form" model="ir.ui.view">
            <field name="name">diamond.packet.issue.correction.wizard.form</field>
            <field name="model">diamond.packet.issue.correction.wizard</field>
            <field name="arch" type="xml">
                <form string="Correct Issue Assignment">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            Use this when the wrong <b>process</b>, <b>employee</b>, or <b>party</b>
                            was selected during issue (e.g. factory issue). Set the correct values below
                            and apply — all selected packets will be updated.
                        </div>
                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="reason" placeholder="e.g. Wrong worker selected on factory issue"/>
                            </group>
                            <group string="Correct To">
                                <field name="show_employee" invisible="1"/>
                                <field name="show_party" invisible="1"/>
                                <field name="new_process_id"
                                       options="{'no_create_edit': True}"/>
                                <field name="new_employee_id"
                                       invisible="not show_employee"
                                       options="{'no_create_edit': True}"/>
                                <field name="new_holder_id"
                                       invisible="not show_party"
                                       options="{'no_create_edit': True}"/>
                            </group>
                        </group>
                        <group string="Selected Packets">
                            <field name="packet_ids" nolabel="1" colspan="2"
                                   domain="['|', ('state', 'in', ('in_process', 'in_factory', 'in_jobwork', 'in_hpht')), '&amp;', ('state', '=', 'in_stock'), ('pending_factory_employee_id', '!=', False)]"
                                   context="{'tree_view_ref': 'diamond_packet_management.view_diamond_packet_correction_packet_list'}"
                                   options="{'no_create': True}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_apply"
                                string="Apply Correction"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_diamond_packet_issue_correction_wizard" model="ir.actions.act_window">
            <field name="name">Correct Issue (Process / Employee)</field>
            <field name="res_model">diamond.packet.issue.correction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
        </record>

        <record id="action_packet_issue_correction_server" model="ir.actions.server">
            <field name="name">Correct Issue (Selected)</field>
            <field name="model_id" ref="model_diamond_packet"/>
            <field name="binding_model_id" ref="model_diamond_packet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = env.ref(
    "diamond_packet_management.action_diamond_packet_issue_correction_wizard"
).sudo().read()[0]
action["context"] = dict(env.context, active_ids=records.ids, active_model="diamond.packet")</field>
        </record>

        <menuitem id="menu_diamond_utility_issue_correction"
                  name="Correct Issue (Process / Employee)"
                  parent="menu_diamond_utility_root"
                  action="action_diamond_packet_issue_correction_wizard"
                  sequence="15"/>

        <menuitem id="menu_diamond_utility_factory_issues"
                  name="Factory Issues"
                  parent="menu_diamond_utility_root"
                  action="action_diamond_factory_issue"
                  sequence="20"/>

        <menuitem id="menu_diamond_utility_factory_receives"
                  name="Factory Receives"
                  parent="menu_diamond_utility_root"
                  action="action_diamond_factory_receive"
                  sequence="25"/>

    </data>
</odoo>
