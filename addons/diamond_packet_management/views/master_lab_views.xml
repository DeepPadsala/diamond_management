<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_diamond_lab_list" model="ir.ui.view">
            <field name="name">diamond.lab.list</field>
            <field name="model">diamond.lab</field>
            <field name="arch" type="xml">
                <list string="Lab Master" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="full_name"/>
                    <field name="website"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
        <record id="action_diamond_lab" model="ir.actions.act_window">
            <field name="name">Labs</field>
            <field name="res_model">diamond.lab</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_lab" name="Lab" parent="menu_diamond_master_other" action="action_diamond_lab" sequence="10"/>
    </data>
</odoo>
