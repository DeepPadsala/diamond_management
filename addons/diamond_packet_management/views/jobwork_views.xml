<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Jobwork Issue (F7) -->
        <record id="view_diamond_jobwork_issue_form" model="ir.ui.view">
            <field name="name">diamond.jobwork.issue.form</field>
            <field name="model">diamond.jobwork.issue</field>
            <field name="arch" type="xml">
                <form string="Jobwork Issue">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state!='draft'"/>
                        <button name="action_cancel"  string="Cancel"  type="object" invisible="state=='cancelled'"/>
                        <button name="action_draft"   string="Reset"   type="object" invisible="state=='draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="process_id"/>
                                <field name="ledger_id" required="1"/>
                                <field name="expected_return_date"/>
                            </group>
                            <group>
                                <field name="employee_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="packet_id"/>
                                <field name="barcode" readonly="1"/>
                                <field name="pcs"/>
                                <field name="cts"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_diamond_jobwork_issue_list" model="ir.ui.view">
            <field name="name">diamond.jobwork.issue.list</field>
            <field name="model">diamond.jobwork.issue</field>
            <field name="arch" type="xml">
                <list><field name="name"/><field name="date"/><field name="ledger_id"/><field name="process_id"/>
                    <field name="total_pcs"/><field name="total_cts"/><field name="expected_return_date"/><field name="state"/></list>
            </field>
        </record>
        <record id="action_diamond_jobwork_issue" model="ir.actions.act_window">
            <field name="name">Jobwork Issue (F7)</field>
            <field name="res_model">diamond.jobwork.issue</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_jobwork_issue" name="F7 Jobwork Issue" parent="menu_diamond_transaction_root"
                  action="action_diamond_jobwork_issue" sequence="40"/>

        <!-- Jobwork Receive (F8) -->
        <record id="view_diamond_jobwork_receive_form" model="ir.ui.view">
            <field name="name">diamond.jobwork.receive.form</field>
            <field name="model">diamond.jobwork.receive</field>
            <field name="arch" type="xml">
                <form string="Jobwork Receive">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state!='draft'"/>
                        <button name="action_cancel"  string="Cancel"  type="object" invisible="state=='cancelled'"/>
                        <button name="action_draft"   string="Reset"   type="object" invisible="state=='draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="process_id"/>
                                <field name="ledger_id"/>
                            </group>
                            <group>
                                <field name="employee_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="packet_id"/>
                                <field name="barcode" readonly="1"/>
                                <field name="pcs"/>
                                <field name="cts"/>
                                <field name="loss_cts"/>
                                <field name="labour_amount"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_diamond_jobwork_receive_list" model="ir.ui.view">
            <field name="name">diamond.jobwork.receive.list</field>
            <field name="model">diamond.jobwork.receive</field>
            <field name="arch" type="xml">
                <list><field name="name"/><field name="date"/><field name="ledger_id"/><field name="process_id"/>
                    <field name="total_pcs"/><field name="total_cts"/><field name="state"/></list>
            </field>
        </record>
        <record id="action_diamond_jobwork_receive" model="ir.actions.act_window">
            <field name="name">Jobwork Receive (F8)</field>
            <field name="res_model">diamond.jobwork.receive</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_jobwork_receive" name="F8 Jobwork Receive" parent="menu_diamond_transaction_root"
                  action="action_diamond_jobwork_receive" sequence="45"/>

    </data>
</odoo>
