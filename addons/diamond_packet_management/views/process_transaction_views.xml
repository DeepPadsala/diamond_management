<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ─────────── Process Issue ─────────── -->
        <record id="view_diamond_process_issue_list" model="ir.ui.view">
            <field name="name">diamond.process.issue.list</field>
            <field name="model">diamond.process.issue</field>
            <field name="arch" type="xml">
                <list string="Process Issue"
                      decoration-info="state=='draft'"
                      decoration-success="state=='confirmed'"
                      decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="process_id"/>
                    <field name="ledger_id"/>
                    <field name="employee_id"/>
                    <field name="total_pcs"/>
                    <field name="total_cts"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_process_issue_form" model="ir.ui.view">
            <field name="name">diamond.process.issue.form</field>
            <field name="model">diamond.process.issue</field>
            <field name="arch" type="xml">
                <form string="Process Issue">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state!='draft'"/>
                        <button name="action_cancel"  string="Cancel"  type="object" invisible="state=='cancelled'"/>
                        <button name="action_draft"   string="Reset"   type="object" invisible="state=='draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="process_id"/>
                                <field name="employee_id"
                                       domain="[('process_ids', 'in', process_id)]"/>
                                <field name="ledger_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="packet_id"/>
                                <field name="barcode" readonly="1"/>
                                <field name="pcs"/>
                                <field name="cts"/>
                                <field name="note"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="total_pcs"/>
                            <field name="total_cts"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_diamond_process_issue" model="ir.actions.act_window">
            <field name="name">Process Issue (F1)</field>
            <field name="res_model">diamond.process.issue</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_process_issue" name="F1 Process Issue" parent="menu_diamond_transaction_root"
                  action="action_diamond_process_issue" sequence="30"/>

        <!-- ─────────── Process Receive ─────────── -->
        <record id="view_diamond_process_receive_list" model="ir.ui.view">
            <field name="name">diamond.process.receive.list</field>
            <field name="model">diamond.process.receive</field>
            <field name="arch" type="xml">
                <list string="Process Receive"
                      decoration-info="state=='draft'"
                      decoration-success="state=='confirmed'"
                      decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="process_id"/>
                    <field name="employee_id"/>
                    <field name="total_pcs"/>
                    <field name="total_cts"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_process_receive_form" model="ir.ui.view">
            <field name="name">diamond.process.receive.form</field>
            <field name="model">diamond.process.receive</field>
            <field name="arch" type="xml">
                <form string="Process Receive">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state!='draft'"/>
                        <button name="action_cancel"  string="Cancel"  type="object" invisible="state=='cancelled'"/>
                        <button name="action_draft"   string="Reset"   type="object" invisible="state=='draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="process_id"/>
                                <field name="employee_id"
                                       domain="[('process_ids', 'in', process_id)]"/>
                                <field name="ledger_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="packet_id"/>
                                <field name="barcode" readonly="1"/>
                                <field name="pcs"/>
                                <field name="cts"/>
                                <field name="loss_cts"/>
                                <field name="party_labour_amount" readonly="1"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_diamond_process_receive" model="ir.actions.act_window">
            <field name="name">Process Receive (F2)</field>
            <field name="res_model">diamond.process.receive</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_process_receive" name="F2 Process Receive" parent="menu_diamond_transaction_root"
                  action="action_diamond_process_receive" sequence="35"/>

    </data>
</odoo>
