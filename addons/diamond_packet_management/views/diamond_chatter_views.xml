        <record id="view_diamond_color_form" model="ir.ui.view">
            <field name="name">diamond.color.form</field>
            <field name="model">diamond.color</field>
            <field name="arch" type="xml">
                <form string="Color">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="grade_value"/>
                            <field name="is_fancy_color"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

