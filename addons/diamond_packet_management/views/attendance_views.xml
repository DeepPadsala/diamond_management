<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_diamond_attendance_list" model="ir.ui.view">
            <field name="name">diamond.attendance.list</field>
            <field name="model">diamond.attendance</field>
            <field name="arch" type="xml">
                <list string="Attendance" editable="bottom"
                      decoration-danger="status=='absent'"
                      decoration-warning="status=='half_day'"
                      decoration-muted="status=='holiday'">
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="status"/>
                    <field name="paid_days"/>
                    <field name="note"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_attendance_form" model="ir.ui.view">
            <field name="name">diamond.attendance.form</field>
            <field name="model">diamond.attendance</field>
            <field name="arch" type="xml">
                <form string="Attendance">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="employee_id"/>
                                <field name="status"/>
                            </group>
                            <group>
                                <field name="paid_days" readonly="1"/>
                                <field name="note"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_diamond_attendance_search" model="ir.ui.view">
            <field name="name">diamond.attendance.search</field>
            <field name="model">diamond.attendance</field>
            <field name="arch" type="xml">
                <search string="Attendance">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <filter name="today" string="Today"
                            domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="absent" string="Absent" domain="[('status','=','absent')]"/>
                    <filter name="present" string="Present" domain="[('status','=','present')]"/>
                    <separator/>
                    <filter name="grp_date" string="Date" context="{'group_by':'date'}"/>
                    <filter name="grp_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_diamond_attendance" model="ir.actions.act_window">
            <field name="name">Attendance</field>
            <field name="res_model">diamond.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_diamond_attendance_search"/>
        </record>

        <menuitem id="menu_diamond_attendance"
                  name="Attendance"
                  parent="menu_diamond_labour_root"
                  action="action_diamond_attendance"
                  sequence="5"/>

    </data>
</odoo>
