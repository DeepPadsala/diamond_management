<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_diamond_employee_list" model="ir.ui.view">
            <field name="name">diamond.employee.list</field>
            <field name="model">diamond.employee</field>
            <field name="arch" type="xml">
                <list string="Employee Master">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="role"/>
                    <field name="salary_type"/>
                    <field name="monthly_salary" optional="hide"/>
                    <field name="process_ids" widget="many2many_tags" optional="show"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="user_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_employee_form" model="ir.ui.view">
            <field name="name">diamond.employee.form</field>
            <field name="model">diamond.employee</field>
            <field name="arch" type="xml">
                <form string="Employee">
                    <sheet>
                        <group col="2">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="join_date"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Capable Processes">
                            <field name="process_ids" widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Payroll">
                            <field name="salary_type"/>
                            <field name="monthly_salary"
                                   invisible="salary_type != 'fixed'"
                                   required="salary_type == 'fixed'"/>
                            <field name="advance_balance" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Withdrawals" groups="diamond_packet_management.group_diamond_manager">
                                <field name="withdrawal_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="amount"/>
                                        <field name="deducted_amount"/>
                                        <field name="balance_amount"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group string="Note"><field name="note" nolabel="1"/></group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_diamond_employee" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">diamond.employee</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_employee" name="Employees" parent="menu_diamond_master_workflow" action="action_diamond_employee" sequence="20"/>
    </data>
</odoo>
