<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_diamond_fluorescence_list" model="ir.ui.view">
            <field name="name">diamond.fluorescence.list</field>
            <field name="model">diamond.fluorescence</field>
            <field name="arch" type="xml">
                <list string="Fluorescence Master" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="grade_value"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
        <record id="action_diamond_fluorescence" model="ir.actions.act_window">
            <field name="name">Fluorescence</field>
            <field name="res_model">diamond.fluorescence</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_diamond_fluorescence" name="Fluorescence" parent="menu_diamond_master_grades" action="action_diamond_fluorescence" sequence="70"/>
    </data>
</odoo>
