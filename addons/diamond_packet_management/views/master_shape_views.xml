<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_diamond_shape_list" model="ir.ui.view">
            <field name="name">diamond.shape.list</field>
            <field name="model">diamond.shape</field>
            <field name="arch" type="xml">
                <list string="Shape Master" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="short_code"/>
                    <field name="name"/>
                    <field name="is_fancy"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_diamond_shape_form" model="ir.ui.view">
            <field name="name">diamond.shape.form</field>
            <field name="model">diamond.shape</field>
            <field name="arch" type="xml">
                <form string="Shape">
                    <sheet>
                        <group col="2">
                            <field name="code"/>
                            <field name="short_code"/>
                            <field name="name"/>
                            <field name="is_fancy"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_diamond_shape" model="ir.actions.act_window">
            <field name="name">Shapes</field>
            <field name="res_model">diamond.shape</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_diamond_shape"
                  name="Shape"
                  parent="menu_diamond_master_grades"
                  action="action_diamond_shape"
                  sequence="10"/>

    </data>
</odoo>
