<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ─────────────── Module security categories ─────────────── -->
        <record id="module_category_diamond" model="ir.module.category">
            <field name="name">Diamond Packet Management</field>
            <field name="description">Roles for the Diamond Packet Management addon.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_diamond_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_diamond"/>
            <field name="comment">Day-to-day operator: scan, inward, outward, issue, receive.</field>
        </record>

        <record id="group_diamond_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_diamond"/>
            <field name="implied_ids" eval="[(4, ref('group_diamond_user'))]"/>
            <field name="comment">Configure masters, run reports, override states.</field>
        </record>

        <!-- Default: every internal user gets at least 'user' -->
        <record id="group_diamond_user" model="res.groups">
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="group_diamond_manager" model="res.groups">
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

